FROM python:3.13-slim-bullseye

ENV DIR="/djangox509"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN mkdir $DIR
WORKDIR $DIR

# Copy dependency files before app code so pip layers are cached independently
COPY requirements.txt setup.py ./
COPY django_x509/ django_x509/
COPY mywifipass/requirements.txt mywifipass/requirements.txt
RUN pip3 install -U pip setuptools wheel && \
    pip3 install . && \
    pip3 install -r mywifipass/requirements.txt

# Copy the rest of the application (invalidates only from here on code changes)
COPY . .

WORKDIR $DIR/mywifipass
EXPOSE 8000
ENV NAME djangox509

ENTRYPOINT ./docker-entrypoint.sh && \
    gunicorn --bind 0.0.0.0:8000 --workers=3 mywifipass.wsgi:application
    #With SSL
    #gunicorn --bind 0.0.0.0:8000 --workers=3 --certfile=cert.pem --keyfile=key.pem mywifipass.wsgi:application
