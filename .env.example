#### MYWIFIPASS CONFIG VARIABLES

# ip or subnet of the access point/s, can be * for any ip
RADIUS_CLIENT_IP=*
# port of the radius server, default is 1812
RADIUS_PORT=1812

# database name
DB_NAME=mywifipass
# username of the database user
DB_USER=mywifipass_user
# password for the user of the database
DB_PASS=your_database_password

# email address for the sender of the emails to the wifi users
EMAIL_HOST_USER=your_email@gmail.com
# password for the email address, if using gmail, you need to create an app password
EMAIL_HOST_PASSWORD="your_app_password"
# whether if the email should use TLS or not
EMAIL_USE_TLS=True
# SMTP server of the email address, if using gmail, it should be smtp.gmail.com
EMAIL_HOST=smtp.gmail.com
# port of the SMTP server, if using gmail, it should be 587
EMAIL_HOST_PORT=587

# Display name for the From header in outbound emails
MYWIFIPASS_FROM_NAME=MyWifiPass
# Play Store link for the MyWifiPass app used in registration emails
MYWIFIPASS_PLAYSTORE_URL=https://play.google.com/store/apps/details?id=app.mywifipass

# port of the webapp, default is 10000
WEBAPP_PORT=10000
# domain name of the webapp, or ip:port if not using a domain name
DOMAIN=domain.example.com
# IP address of the server
SERVER_IP=X.X.X.X
ALLOWED_HOSTS=domain.example.com


# if you want to use debug mode set to true, not recommended for production
DEBUG=False
# if you want to use SSL, set it to True
SSL=False
# timezone of the server, default is UTC, for Spain it should be Europe/Madrid for example
TZ="Europe/Madrid"

#### FIDO2 CONFIGURATION (Optional - for Android app support)

# By default, the official MyWifiPass app (app.mywifipass) is always included.
# Use this variable ONLY to add custom-compiled apps (not to replace the official one).

# Additional Android app origins (format: comma-separated android:apk-key-hash: values)
# Leave empty to use only the official app.
# Add custom app hashes here if you compile your own version:
# Example: ANDROID_ADDITIONAL_ORIGINS=android:apk-key-hash:CUSTOM_HASH1,android:apk-key-hash:CUSTOM_HASH2
ANDROID_ADDITIONAL_ORIGINS=

# Additional Android apps for Digital Asset Links (JSON format, semi-optional)
# Leave empty to use only the official app.
# Use this if you have custom-compiled apps with different package names.
# Example: ANDROID_ADDITIONAL_APPS=[{"package_name":"com.mycompany.mywifipass","sha256":"AA:BB:CC:DD:..."}]
# Format: JSON array with object(s) containing 'package_name' and 'sha256' fields
ANDROID_ADDITIONAL_APPS=